POSTGRES_DSN=sqlite:///./data/mrp.sqlite
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mrp-renders
ARTIFACT_ROOT=./data/renders
PARQUET_ROOT=./data/parquet
USE_S3=false

# Streaming (optional; leave unset to disable streaming path)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=render.events
KAFKA_GROUP=mrp-consumer
KAFKA_DLQ_TOPIC=render.events.dlq
KAFKA_MAX_RETRIES=3
